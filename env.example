# LLM Position Bias Analysis Framework - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (Optional)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
# Default model to use for analysis
DEFAULT_MODEL=gpt-3.5-turbo

# API Backend Configuration
# Default backend to use (openai, anthropic, custom)
DEFAULT_BACKEND=openai

# Rate Limiting Configuration
# API tier for rate limiting (basic, tier_1, tier_2)
DEFAULT_API_TIER=tier_1

# Dataset Configuration
# Default dataset to use for analysis
DEFAULT_DATASET=movie_lens

# Analysis Configuration
# Default number of bias users
DEFAULT_NUM_BIAS_USERS=5

# Default number of evaluation users
DEFAULT_NUM_EVAL_USERS=200

# Default number of shuffles for bias analysis
DEFAULT_NUM_SHUFFLES=50

# Default candidate list size
DEFAULT_LIST_SIZE=100

# Logging Configuration
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Output Configuration
# Directory for saving results
OUTPUT_DIR=outputs

# Checkpoint Configuration
# Directory for saving checkpoints
CHECKPOINT_DIR=checkpoints

# Development Configuration
# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE=false

# Testing Configuration
# Use mock responses for testing (true/false)
USE_MOCK_RESPONSES=false

# Mock response file path
MOCK_RESPONSES_FILE=mock_responses.json
